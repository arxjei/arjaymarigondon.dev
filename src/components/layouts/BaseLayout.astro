---
import type { GitHubUser } from "@lib/github";
import "@assets/styles/global.css";
import "@assets/styles/progressbar.css";
import BaseHead from "./includes/BaseHead.astro";

interface Props {
	title: string;
	description: string;
	classList?: string;
	pageTitle?: string;
	ogImage?: URL;
	userData: GitHubUser;
}

const { title, description, classList, pageTitle, ogImage, userData } =
	Astro.props;
---

<html
	lang="en"
	class="h-full">
	<BaseHead
		ogImage={ogImage}
		title={title}
		description={description}
	/>

	<body
		id="my-background"
		class:list={classList}>
		<div
			class="bg-zinc-950 text-zinc-100 min-h-screen flex items-center justify-center px-6 py-20">
			<slot />
		</div>

		<script>
			import { initProgressBar } from "@assets/js/progressbar.js";
			initProgressBar();
		</script>
	</body>
</html>
