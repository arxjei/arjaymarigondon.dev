---
export const prerender = true;

import { github } from "@lib/github";
import BaseLayout from "@components/layouts/BaseLayout.astro";

const userData = await github.getUser();
---

<BaseLayout
	title="Home"
	pageTitle=`Home`
	description=`Welcome Explore projects.`
	userData={userData}>
	<main class="max-w-xl w-full space-y-6">
		<img
			src={userData.avatar_url}
			alt="Profile Picture"
			class="w-32 h-32 rounded-full border-4 border-yellow-400"
		/>
		<p class="text-zinc-500 text-xs tracking-widest uppercase">
			its a pleasure to meet you!
		</p>
		<h1 class="text-5xl text-white leading-tight">
			Hi there! <span class="text-yellow-400">⚡</span><br />
			I'm Jei.
		</h1>
		<h2 class="text-2xl text-zinc-400 italic">
			Used to build web apps. Now I build content.
		</h2>
		<p class="text-zinc-500 text-sm leading-relaxed">
			Programming? is still a beloved hobby - just no longer the main act.
			If you want to get in touch, you can email me at
			<a href="mailto:hey@arjaymarigondon.dev" class="text-yellow-400 hover:underline">
			hey@arjaymarigondon.dev
			</a>
		</p>
	</main>
</BaseLayout>
